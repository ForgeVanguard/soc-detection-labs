// Lab 02 - Elastic ES|QL over firewall or Zeek data mapped to ECS
FROM logs-*
| WHERE event.category == "network" AND destination.port IS NOT NULL
| EVAL bucket = DATE_TRUNC(5 minutes, @timestamp)
| STATS distinct_ports = COUNT_DISTINCT(destination.port), attempts = COUNT(*) BY bucket, source.ip, destination.ip
| WHERE distinct_ports >= 20
| SORT distinct_ports DESC
