// Lab 11 - Microsoft Sentinel (SecurityEvent)
SecurityEvent
| where EventID == 4625 and SubStatus in~ ("0xc000006a", "0xc0000064")
| summarize Failures = count(), DistinctAccounts = dcount(TargetUserName), Accounts = make_set(TargetUserName, 50), LogonTypes = make_set(LogonType)
    by bin(TimeGenerated, 10m), IpAddress
| where DistinctAccounts >= 10
| order by DistinctAccounts desc
