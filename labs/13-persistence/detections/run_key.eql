// Lab 13 - Elastic EQL: Run key set by a process running from a user-writable path
registry where host.os.type == "windows" and event.type == "change" and
  registry.path : ("*\\CurrentVersion\\Run\\*", "*\\CurrentVersion\\RunOnce\\*") and
  process.executable : ("C:\\Users\\*", "C:\\ProgramData\\*", "C:\\Windows\\Temp\\*")
