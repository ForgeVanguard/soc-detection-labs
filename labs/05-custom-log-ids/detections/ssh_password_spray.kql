// Lab 05 - Microsoft Sentinel (Syslog)
Syslog
| where ProcessName == "sshd" and SyslogMessage startswith "Failed "
| extend User = extract(@"for (?:invalid user )?(\S+) from", 1, SyslogMessage),
         SrcIp = extract(@"from (\S+) port", 1, SyslogMessage)
| summarize Failures = count(), DistinctUsers = dcount(User) by bin(TimeGenerated, 1m), HostName, SrcIp
| extend Rule = case(DistinctUsers >= 5, "PASSWORD_SPRAY", Failures >= 5, "BRUTE_FORCE", "")
| where Rule != ""
