// Lab 05 - Elastic ES|QL (system integration, auth dataset)
FROM logs-system.auth-*
| WHERE system.auth.ssh.event == "Failed"
| EVAL bucket = DATE_TRUNC(1 minute, @timestamp)
| STATS failures = COUNT(*), distinct_users = COUNT_DISTINCT(user.name) BY bucket, host.name, source.ip
| EVAL rule = CASE(distinct_users >= 5, "PASSWORD_SPRAY", failures >= 5, "BRUTE_FORCE", null)
| WHERE rule IS NOT NULL
